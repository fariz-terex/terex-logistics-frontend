+function DeliveryDetail({ delivery, onBack, onApprove, onReject, onAdvance, role, materials, api }) {
   const canApprove = (role === ROLES.LOGISTICS || role === ROLES.MANAGER) && delivery.status === "Waiting Logistics Approval";
